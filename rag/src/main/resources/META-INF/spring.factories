# 检索通道配置一致性校验：启动最前置的环境后置处理器
org.springframework.boot.EnvironmentPostProcessor=\
  io.github.qyl66.storeagent.rag.config.validation.RetrievalConfigEnvironmentPostProcessor,\
  io.github.qyl66.storeagent.rag.config.validation.JevConfigEnvironmentPostProcessor

# 检索通道配置矛盾的启动诊断器（把 RetrievalConfigException 渲染成 APPLICATION FAILED TO START 框）
org.springframework.boot.diagnostics.FailureAnalyzer=\
  io.github.qyl66.storeagent.rag.config.validation.RetrievalConfigFailureAnalyzer,\
  io.github.qyl66.storeagent.rag.config.validation.JevConfigFailureAnalyzer
